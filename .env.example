# Kopie als .env anlegen. .env wird nie eingecheckt.

# Supabase Projekt (EU-Region)
SUPABASE_URL=https://DEIN-PROJEKT.supabase.co
SUPABASE_ANON_KEY=

# Nur fuer Edge Functions und Migrationen, niemals in der App
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_PASSWORD=

# LLM fuer Scan-Strukturierung und Auto-Kategorisierung.
# Wird ausschliesslich in Edge Functions gelesen. Ein Key im App-Bundle
# ist ein geleakter Key.
ANTHROPIC_API_KEY=

# Kontingente pro Nutzer und Monat
SCAN_LIMIT_PER_MONTH=30
LLM_TOKEN_LIMIT_PER_MONTH=400000
